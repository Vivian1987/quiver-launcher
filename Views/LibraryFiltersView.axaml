<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:QuiverLauncher.ViewModels" xmlns:services="using:QuiverLauncher.Services" x:Class="QuiverLauncher.Views.LibraryFiltersView" x:DataType="vm:LibraryFiltersViewModel" x:CompileBindings="True">
<Grid x:Name="Surface" RowDefinitions="Auto,*">
				<!-- Sort and Show: how the list is ordered and which apps it includes. -->
				<StackPanel Grid.Row="0" Margin="12,4,12,10" Spacing="8">
					<Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="-12,0,-12,2"/>
					<Grid x:Name="SortSection" ColumnDefinitions="48,*">
						<TextBlock Classes="sidebar-field-label" Text="Sort"/>
						<ComboBox x:Name="SortByComboBox"
								  Grid.Column="1"
								  HorizontalAlignment="Stretch"
								  Foreground="{DynamicResource ThemeText}"
								  Background="{DynamicResource ThemeDarker}"
								  BorderBrush="{DynamicResource ThemeBorder}"
								  MinHeight="32"
								  SelectionChanged="SortByComboBox_SelectionChanged">
							<ComboBoxItem Content="Name (A-Z)" Tag="Name"/>
							<ComboBoxItem Content="Name (Z-A)" Tag="NameDesc"/>
							<ComboBoxItem Content="Installed First" Tag="Installed"/>
							<ComboBoxItem Content="Not Installed First" Tag="NotInstalled"/>
							<ComboBoxItem Content="Last Played" Tag="LastPlayed"/>
						</ComboBox>
					</Grid>
					<Grid ColumnDefinitions="48,*">
						<TextBlock Classes="sidebar-field-label" Text="Show"/>
						<Border Grid.Column="1" Classes="sidebar-segmented">
							<Grid ColumnDefinitions="*,1,*,1,*">
								<Button x:Name="UnhideAllGamesButton"
										Classes="settings scope-filter scope-segment"
										Content="All"
										ToolTip.Tip="All apps"
										Click="UnhideAllGamesButton_Click"/>
								<Border Grid.Column="1" Background="{DynamicResource ThemeBorder}"/>
								<Button x:Name="HideNonInstalledButton"
										Grid.Column="2"
										Classes="settings scope-filter scope-segment"
										Content="Installed"
										ToolTip.Tip="Installed apps only"
										Click="HideNonInstalledButton_Click"/>
								<Border Grid.Column="3" Background="{DynamicResource ThemeBorder}"/>
								<Button x:Name="ShowHiddenGamesButton"
										Grid.Column="4"
										Classes="settings scope-filter scope-segment"
										Content="Hidden"
										ToolTip.Tip="Apps you have hidden"
										Click="ShowHiddenGamesButton_Click"/>
							</Grid>
						</Border>
					</Grid>
				</StackPanel>

				<!-- Filters: player ratings and the player's own tag filters. -->
				<ScrollViewer x:Name="LibraryFiltersScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="12,0,12,0">
							<Border Height="1"
									Background="{DynamicResource ThemeBorder}"
									Margin="-12,0,-12,6"/>

							<Grid ColumnDefinitions="*,Auto" Margin="0,0,4,4">
								<Button x:Name="FiltersSectionToggle"
										Grid.Column="0"
										Classes="settings"
										Padding="0,6"
										HorizontalAlignment="Stretch"
										AutomationProperties.Name="Filters"
										Click="FiltersSectionToggle_Click">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<TextBlock Text="FILTERS"
												   FontSize="10"
												   FontWeight="Bold"
												   Foreground="{DynamicResource ThemeTextSecondary}"
												   LetterSpacing="1"
												   VerticalAlignment="Center"/>
										<Path x:Name="FiltersSectionChevron"
											  Width="12" Height="12"
											  Stroke="{DynamicResource ThemeTextSecondary}"
											  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
											  VerticalAlignment="Center"
											  Data="M3,4.5 L6,7.5 L9,4.5"/>
									</StackPanel>
								</Button>
								<Button x:Name="AddDisplayFilterButton"
										Grid.Column="1"
										Classes="iconbutton tag-filter-add"
										Width="24"
										Height="24"
										ToolTip.Tip="Add filter"
										Click="AddDisplayFilter_Click">
									<TextBlock Text="+"
											   FontSize="16"
											   FontWeight="Bold"
											   HorizontalAlignment="Center"
											   VerticalAlignment="Center"
											   TextAlignment="Center"/>
								</Button>
							</Grid>

							<StackPanel x:Name="FiltersSectionBody">

							<!-- Rating: what players report on quiverlauncher.com, for apps from the App Catalog. -->
							<Grid ColumnDefinitions="48,*" Margin="0,0,0,8">
								<TextBlock Classes="sidebar-field-label" Text="Rating"/>
								<Button x:Name="RatingFilterButton"
										Grid.Column="1"
										Classes="settings sidebar-dropdown"
										HorizontalAlignment="Stretch"
										HorizontalContentAlignment="Stretch">
									<Button.Flyout>
										<MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="RatingFlyout_Opening">
											<MenuItem Tag="runs" ToggleType="CheckBox" StaysOpenOnClick="True" Click="RatingFilter_Click">
												<MenuItem.Header>
													<StackPanel Orientation="Horizontal" Spacing="8">
														<Ellipse Width="8" Height="8" Fill="#8ac3a2" VerticalAlignment="Center"/>
														<TextBlock Text="Runs well" VerticalAlignment="Center"/>
													</StackPanel>
												</MenuItem.Header>
											</MenuItem>
											<MenuItem Tag="issues" ToggleType="CheckBox" StaysOpenOnClick="True" Click="RatingFilter_Click">
												<MenuItem.Header>
													<StackPanel Orientation="Horizontal" Spacing="8">
														<Ellipse Width="8" Height="8" Fill="#d7b56a" VerticalAlignment="Center"/>
														<TextBlock Text="Has issues" VerticalAlignment="Center"/>
													</StackPanel>
												</MenuItem.Header>
											</MenuItem>
											<MenuItem Tag="broken" ToggleType="CheckBox" StaysOpenOnClick="True" Click="RatingFilter_Click">
												<MenuItem.Header>
													<StackPanel Orientation="Horizontal" Spacing="8">
														<Ellipse Width="8" Height="8" Fill="#e38c87" VerticalAlignment="Center"/>
														<TextBlock Text="Doesn't run" VerticalAlignment="Center"/>
													</StackPanel>
												</MenuItem.Header>
											</MenuItem>
											<MenuItem Tag="unrated" ToggleType="CheckBox" StaysOpenOnClick="True" Click="RatingFilter_Click"
													  ToolTip.Tip="No player reports yet, or not from the App Catalog">
												<MenuItem.Header>
													<StackPanel Orientation="Horizontal" Spacing="8">
														<Ellipse Width="8" Height="8" Fill="#8f929b" VerticalAlignment="Center"/>
														<TextBlock Text="Not rated yet" VerticalAlignment="Center"/>
													</StackPanel>
												</MenuItem.Header>
											</MenuItem>
										</MenuFlyout>
									</Button.Flyout>
									<Grid ColumnDefinitions="*,Auto">
										<TextBlock x:Name="RatingFilterSummary"
												   Text="Any rating"
												   TextTrimming="CharacterEllipsis"
												   VerticalAlignment="Center"/>
										<Path Grid.Column="1"
											  Width="12" Height="12"
											  Margin="6,0,0,0"
											  Stroke="{DynamicResource ThemeTextSecondary}"
											  StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
											  VerticalAlignment="Center"
											  Data="M3,4.5 L6,7.5 L9,4.5"/>
									</Grid>
								</Button>
							</Grid>
							<ItemsControl x:Name="TagDisplayFiltersItemsControl"
										  ItemsSource="{Binding TagDisplayFilters}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="services:TagDisplayFilterListItem">
										<Button Classes="settings display-filter-row"
												Classes.selected="{Binding IsSelected}"
												Margin="0,0,0,4"
												HorizontalAlignment="Stretch"
												HorizontalContentAlignment="Stretch"
												Click="TagDisplayFilterButton_Click"
												Tag="{Binding Id}">
											<Grid ColumnDefinitions="*,Auto,Auto">
                                            <Grid Grid.Column="0" ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                                                <TextBlock Grid.Column="1" Text="✓" IsVisible="{Binding IsSelected}" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource ThemeAccent}" FontWeight="Bold" VerticalAlignment="Center"/>
													<TextBlock Grid.Column="0" Classes="display-filter-name"
															   Text="{Binding Name}"
															   TextTrimming="CharacterEllipsis"
															   VerticalAlignment="Center"/>
                                            </Grid>
													<Border Grid.Column="1"
															Classes="display-filter-reorder"
															Width="28"
															Height="28"
															Margin="4,0,0,0"
															VerticalAlignment="Center"
															Tag="{Binding Id}"
															PointerPressed="TagDisplayFilterReorder_PointerPressed">
														<TextBlock Text="↕"
																   FontSize="14"
																   IsHitTestVisible="False"
																   HorizontalAlignment="Center"
																   VerticalAlignment="Center"/>
													</Border>
													<Button Grid.Column="2"
															Classes="options options-listview display-filter-overflow"
															Content="⋯"
															FontSize="18"
															Width="28"
															Height="28"
															Padding="0"
															Margin="2,0,0,0"
															VerticalAlignment="Center"
															Click="DisplayFilterOverflow_Click"
															Tag="{Binding Id}">
														<Button.ContextMenu>
															<ContextMenu>
																<MenuItem Header="Edit"
																		  Tag="{Binding Id}"
																		  Click="EditTagDisplayFilter_Click"/>
																<MenuItem Header="Move Up"
																		  Tag="{Binding Id}"
																		  Click="MoveTagDisplayFilterUp_Click"/>
																<MenuItem Header="Move Down"
																		  Tag="{Binding Id}"
																		  Click="MoveTagDisplayFilterDown_Click"/>
																<MenuItem Header="Delete"
																		  Tag="{Binding Id}"
																		  Click="DeleteTagDisplayFilter_Click"/>
															</ContextMenu>
														</Button.ContextMenu>
													</Button>
												</Grid>
										</Button>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							</StackPanel>
						</StackPanel>
				</ScrollViewer>
				</Grid>
</UserControl>
